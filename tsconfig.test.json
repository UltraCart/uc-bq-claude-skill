{
  // Compiles src/ and test/ together into dist-test/.
  //
  // Tests deliberately run as CommonJS, matching the shipped build: several
  // modules (src/lib/llm/index.ts) call require() at runtime to load provider
  // SDKs lazily, which would be undefined under ESM. Running the tests in the
  // same module system as production means they exercise the real code path.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-test",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "dist-test"]
}
